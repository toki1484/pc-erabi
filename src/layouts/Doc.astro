---
// 運営者情報・プライバシーポリシーのような文章ページ用のレイアウト。
// 記事ページと見た目を揃えるため、本文のスタイル定義をここに集約する。
import Base from './Base.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  updated?: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={`${title} | ${SITE.name}`} description={description}>
  <div class="wrap">
    <p class="back"><a href="/">← トップへ</a></p>
    <article>
      <h1>{title}</h1>
      {updated && <p class="meta">最終更新: {updated}</p>}
      <div class="body">
        <slot />
      </div>
    </article>
  </div>

  <style>
    .wrap { max-width: 760px; margin: 0 auto; padding: 32px 20px 0; }
    .back { font-size: 0.9rem; margin: 0 0 16px; }
    h1 { font-size: clamp(1.4rem, 4.5vw, 1.9rem); margin: 0 0 8px; }
    .meta { margin: 0 0 28px; font-size: 0.85rem; color: var(--text-dim); }
    .body :global(h2) { font-size: 1.2rem; margin: 36px 0 12px; }
    .body :global(h3) { font-size: 1.05rem; margin: 28px 0 10px; }
    .body :global(p) { margin: 0 0 16px; }
    .body :global(ul), .body :global(ol) { padding-left: 1.3em; margin: 0 0 16px; }
    .body :global(li) { margin-bottom: 8px; }
    .body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 20px; font-size: 0.92rem; }
    .body :global(th), .body :global(td) { border: 1px solid var(--border); padding: 8px 10px; text-align: left; }
    .body :global(th) { background: var(--surface-2); }
  </style>
</Base>
