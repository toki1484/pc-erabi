---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPublishedArticles } from '../../lib/articles.js';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// 記事を読み終えた人の次の行き先。ここが無いと、読んで終わりになる。
const others = (await getPublishedArticles())
  .filter((a) => a.id !== article.id)
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${article.data.title} | ${SITE.name}`} description={article.data.description}>
  <div class="wrap">
    <p class="back"><a href="/articles/">← 記事一覧</a></p>

    <article>
      <h1>{article.data.title}</h1>
      <p class="meta">
        <time datetime={article.data.publishDate.toISOString()}>{fmt(article.data.publishDate)}</time>
        <span>・{SITE.author}</span>
        {!article.data.factChecked && <span class="badge">未確認（開発表示）</span>}
      </p>

      <div class="body">
        <Content />
      </div>

      {article.data.sources.length > 0 && (
        <section class="sources">
          <h2>出典</h2>
          <ul>
            {article.data.sources.map((s) => (
              <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="next">
        <h2>次にできること</h2>
        <p>
          遊びたいタイトルと目標の解像度・フレームレートを選ぶと、
          必要なGPU・CPU・メモリの目安を表示します。
        </p>
        <p><a class="cta" href="/">スペック診断をひらく</a></p>

        {others.length > 0 && (
          <>
            <h3>ほかの記事</h3>
            <ul>
              {others.map((a) => (
                <li><a href={`/articles/${a.id}/`}>{a.data.title}</a></li>
              ))}
            </ul>
          </>
        )}
      </section>
    </article>
  </div>

  <style>
    .back { font-size: 0.9rem; margin: 0 0 16px; }
    h1 { font-size: clamp(1.4rem, 4.5vw, 1.9rem); margin: 0 0 8px; }
    .meta { margin: 0 0 28px; font-size: 0.85rem; color: var(--text-dim); }
    .body :global(h2) { font-size: 1.2rem; margin: 36px 0 12px; }
    .body :global(h3) { font-size: 1.05rem; margin: 28px 0 10px; }
    .body :global(p) { margin: 0 0 16px; }
    .body :global(ul), .body :global(ol) { padding-left: 1.3em; margin: 0 0 16px; }
    .body :global(li) { margin-bottom: 8px; }
    .body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 20px; font-size: 0.92rem; }
    .body :global(th), .body :global(td) {
      border: 1px solid var(--border);
      padding: 8px 10px;
      text-align: left;
    }
    .body :global(th) { background: var(--surface-2); }
    .body :global(code) { background: var(--surface-2); padding: 1px 5px; border-radius: 4px; }
    .body :global(pre) { background: var(--surface-2); padding: 12px; border-radius: 8px; overflow-x: auto; }
    .body :global(blockquote) {
      margin: 0 0 16px;
      padding: 2px 14px;
      border-left: 3px solid var(--border);
      color: var(--text-dim);
    }
    .sources { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--border); }
    .sources h2 { font-size: 1rem; margin: 0 0 10px; }
    .sources ul { padding-left: 1.2em; margin: 0; font-size: 0.9rem; }
    .next { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--border); }
    .next h2 { font-size: 1.1rem; margin: 0 0 10px; }
    .next h3 { font-size: 0.95rem; margin: 28px 0 8px; color: var(--text-dim); }
    .next p { margin: 0 0 14px; font-size: 0.95rem; }
    .next ul { padding-left: 1.2em; margin: 0; font-size: 0.92rem; }
    .next li { margin-bottom: 6px; }
    .cta {
      display: inline-block;
      padding: 10px 18px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface-2);
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</Base>
